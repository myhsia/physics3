          {\begingroup
            \phx@abopen\vert
              \mathopen{\phx@mathvphantom{#3}}#3\phx@abclose\rangle
            \phx@abopen\langle#3
              \mathclose{\phx@mathvphantom{#3}}\phx@abclose\vert
