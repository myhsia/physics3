%     "  "\meta{subformula} \meta{right delimiter}\\
%     \cs{phx@d@lxab} \phantom{\meta{biggg or *}} \meta{left delimiter}\\
%     "  "\meta{subformula} \meta{right delimiter}
%   \end{quote}
