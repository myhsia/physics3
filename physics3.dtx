%   \end{quote}
%   \meta{n.roman} is $n$ in roman lowercase, where $n \in \{1,2,3\}$.
%    \begin{macrocode}
\def\phx@bk@in@i#1{%
  \csname\@phx@bk@l\endcsname\langle{#1}%
  \csname\@phx@bk@r\endcsname\rangle}
