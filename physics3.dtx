\begin{example}{12}
\def \0{\frac\alpha2}
\edef\1{\uparrow,\downarrow}
$ \bknorm           \0 $\quad
$ \bknorm*          \0 $\quad
$ \bknorm[big]      \0 $\\[2ex]
