% "\newcommand\mqty[1]{\begin{matrix}#1\end{matrix}}"\\
% "\newcommand\pmqty[1]{\begin{pmatrix}#1\end{pmatrix}}"\\
% "$\ab(\mqty{foo})$"  or  "$\pmqty{foo}$"
% \end{quote}
