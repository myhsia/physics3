\DeclareDocumentCommand \bknorm { s o m }
  {%
    \IfBooleanTF{#1} {\mathopen\langle#3\vert #3\mathclose\rangle}
      {%
        \IfValueTF{#2}
          {\expanded{\noexpand\phx@d@lx{bk.m}{bk.a}%
