  \csname\@phx@bk@m\endcsname\vert{#2}%
  \csname\@phx@bk@r\endcsname\rangle}
\def\phx@bk@in@iii#1#2#3{%
  \csname\@phx@bk@l\endcsname\langle{#1}%
  \csname\@phx@bk@m\endcsname\vert{#2}%
  \csname\@phx@bk@m\endcsname\vert{#3}%
