  {%
    \IfBooleanTF{#1}
      {%
        \mathopen\vert#3\mathclose\rangle
        \mathopen\langle#3\mathclose\vert
      }
      {%
        \IfValueTF{#2}
          {\expanded{\noexpand\phx@d@lx{kb.m}{kb.a}%
            \expandafter\noexpand\csname #2\endcsname}|#3><#3|}
          {\phx@d@lx{kb.m}{kb.a}|#3><#3|}%
      }%
  }
